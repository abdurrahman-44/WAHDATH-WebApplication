# Copy this file to .env in the same folder (server/.env) and fill in your key.
# NEVER put this key in any frontend/browser code (see section 42 of the spec).

# Get a key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5 if not set.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional — port for the local dev server.
PORT=8787

# Web Push (Adhan notifications) — generate your own with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
